{
  "name": "@lovebind/api",
  "version": "0.2.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch --require ts-node/register src/main.ts",
    "start": "node dist/main.js",
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --require ts-node/register src/modules/compatibility/scoring.test.ts src/modules/auth/auth.validation.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.19.0",
    "dotenv": "^16.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/express": "^5.0.0",
    "prisma": "^6.19.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.0"
  }
}
