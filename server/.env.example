# Copy to server/.env.local; do not commit the populated file.
DATABASE_URL=your_neon_development_pooled_connection_string
# Optional: use a separate, NON-POOLED Neon URL for Prisma migrations.
# DIRECT_DATABASE_URL=your_neon_direct_connection_string
PORT=4000
CORS_ORIGINS=http://localhost:8081,http://localhost:3000,http://localhost:5173
NODE_ENV=development
OPENAI_API_KEY=
OPENAI_MODEL=

# Private profile photo storage (server-side only)
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Trusted moderator User.id values (comma-separated). No value means no moderator access.
# LOVEBIND_MODERATOR_IDS=

# Dedicated moderator account bootstrap (backend only). Both are required.
# Choose a NEW email not registered as a dating member; password >=16 chars.
# Set these in Render server environment, NEVER admin/VITE_* or GitHub.
# LOVEBIND_ADMIN_EMAIL=
# LOVEBIND_ADMIN_PASSWORD=

# Private 1:1 chats: generate a unique 32-byte key with: openssl rand -hex 32
# Store only in Render backend secrets and local untracked .env, never Expo.
# Keep the key backed up securely: losing it makes stored messages unreadable.
# LOVEBIND_CHAT_ENCRYPTION_KEY=

# Compatibility questionnaire answers (dedicated AES-256-GCM key, different from the chat key).
# Generate once using: openssl rand -hex 32
# Keep this in a server secret vault. Losing it makes past answers unreadable.
# LOVEBIND_QUIZ_ENCRYPTION_KEY=

# FUTURE PayFast Hosted Checkout integration (sandbox first).
# Set only on backend, never Expo. No payments/credit issuance are enabled yet.
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=
# PAYFAST_ENVIRONMENT=sandbox

# Account deletion: configure only after explicit policy approval (see docs/ACCOUNT_DELETION.md).
# LOVEBIND_DELETION_POLICY_APPROVED=true
# LOVEBIND_DELETION_POLICY_VERSION=approved-document-version
# LOVEBIND_DELETION_SAFETY_DAYS=<approved-days>
# LOVEBIND_DELETION_FINANCIAL_DAYS=<approved-days>
