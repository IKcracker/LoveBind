# Copy to server/.env.local; do not commit the populated file.
DATABASE_URL=your_neon_development_pooled_connection_string
# Optional: use a separate, NON-POOLED Neon URL for Prisma migrations.
# DIRECT_DATABASE_URL=your_neon_direct_connection_string
PORT=4000
CORS_ORIGINS=http://localhost:8081,http://localhost:3000
NODE_ENV=development
OPENAI_API_KEY=
OPENAI_MODEL=

# Private profile photo storage (server-side only)
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Server-side Google Places API (New) key for city autocomplete
# GOOGLE_PLACES_API_KEY=
