# COPY TO server/.env and substitute your OWN credentials locally.
# NEVER commit server/.env, database passwords, service-role keys or API secrets.
DATABASE_URL="postgresql://USERNAME:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require"
OPENAI_API_KEY=""
OPENAI_MODEL=""
PORT=4000
CORS_ORIGINS=http://localhost:8081,http://localhost:3000
NODE_ENV=development
