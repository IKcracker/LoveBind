# Copy to server/.env.local; do not commit the populated file.
DATABASE_URL=your_neon_development_pooled_connection_string
# Optional: use a separate, NON-POOLED Neon URL for Prisma migrations.
# DIRECT_DATABASE_URL=your_neon_direct_connection_string
PORT=4000
CORS_ORIGINS=http://localhost:8081,http://localhost:3000,http://localhost:5173
NODE_ENV=development
OPENAI_API_KEY=
OPENAI_MODEL=

# Private profile photo storage (server-side only)
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Trusted moderator User.id values (comma-separated). No value means no moderator access.
# LOVEBIND_MODERATOR_IDS=

# Dedicated moderator account bootstrap (backend only). Both are required.
# Choose a NEW email not registered as a dating member; password >=16 chars.
# Set these in Render server environment, NEVER admin/VITE_* or GitHub.
# LOVEBIND_ADMIN_EMAIL=
# LOVEBIND_ADMIN_PASSWORD=
